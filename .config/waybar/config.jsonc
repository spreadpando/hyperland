// Waybar config — matching polybar pando theme
{
    "position": "bottom",
    "height": 24,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces",
        "cpu",
        "custom/gpu",
        "memory",
        "disk",
        "disk#ssd2",
        "custom/decor-close"
    ],
    "modules-center": [
        "custom/decor-open",
        "clock",
        "hyprland/window",
        "custom/decor-close#center"
    ],
    "modules-right": [
        "custom/decor-open#right",
        "pulseaudio",
        "tray",
        "custom/powermenu"
    ],

    "hyprland/workspaces": {
        "format": "{name} {icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "active": "",
            "default": ""
        },
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },

    "cpu": {
        "interval": 1,
        "format": "<span color='#B89C7A'></span> {usage}%",
        "tooltip": false
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/gpu-usage.sh",
        "interval": 1,
        "format": "<span color='#7D7DB8'></span> {}%",
        "tooltip": false
    },

    "memory": {
        "interval": 1,
        "format": "<span color='#7A9CB8'></span> {used:0.0f} MB",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
    },

    "disk": {
        "interval": 30,
        "format": "<span color='#B87A7A'></span> / {free}",
        "path": "/"
    },

    "disk#ssd2": {
        "interval": 30,
        "format": "<span color='#B87A7A'></span> ssd2 {free}",
        "path": "/mnt/ssd2"
    },

    "clock": {
        "interval": 1,
        "format": "<span color='#B88A8A'></span> {:%c}",
        "format-alt": "<span color='#B88A8A'></span> {:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "hyprland/window": {
        "format": " {}",
        "max-length": 55,
        "separate-outputs": true
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰕟 Muted",
        "format-icons": {
            "default": ["󰕟", "󰕠", "󰕞"]
        },
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "custom/powermenu": {
        "format": "<span color='#B88A8A'>襤</span>",
        "on-click": "~/.config/rofi/powermenu/type-1/powermenu.sh",
        "tooltip": false
    },

    "custom/decor-close": {
        "format": "",
        "tooltip": false
    },

    "custom/decor-close#center": {
        "format": "",
        "tooltip": false
    },

    "custom/decor-open": {
        "format": "",
        "tooltip": false
    },

    "custom/decor-open#right": {
        "format": "",
        "tooltip": false
    }
}
